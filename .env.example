ROCKET_DASHBOARD_URL=http://localhost:3000
SQLITE_PATH=work/rocket1000.sqlite
# Production operator settings; never entered by the EA user:
# ROCKET_DASHBOARD_URL=https://your-dashboard.example
# ROCKET_BACKEND_URL=https://your-dashboard.example
# DATABASE_URL=postgresql://... (shared database required on Vercel)
# ROCKET_REQUIRE_POSTGRES=1
# ROCKET_RELEASE_ANALYSIS_ONLY=1 keeps all broker submissions disabled while
# retaining OpenAI analysis, broker telemetry and read-only reconciliation.
# ROCKET_DISABLE_LIVE_ORDERS=1 (independent operator Live-order safety switch;
# keep the current production value unchanged during development and review)
# Set OPENAI_API_KEY as a Production Secret in the existing Vercel project.
# OPENAI_API_KEY=... (server-only; never prefix with NEXT_PUBLIC_)
# Optional for the server key only. Use the actual owning organization/project
# if explicit routing is needed. Leave unset for a normal project-scoped key.
# OPENAI_ORG_ID=org-...
# OPENAI_PROJECT_ID=proj_...
# Server-managed OpenAI is the default: the gear drawer has status/Test Connection.
ROCKET_OPENAI_SERVER_MANAGED=1
# OPENAI_API_KEY and OPENAI_MODEL are read only on the backend/worker. No key is
# returned to the browser, stored in the APK, or accepted by the normal browser API.
# Historical encrypted workspace credentials remain unused; a prior Remove
# tombstone still blocks requests until an operator reviews the workspace.
# ROCKET_OPENAI_ENCRYPTION_KEY=<canonical base64 of 32 cryptographically random bytes>
# Keep that encryption secret separate from the database and API key. Set the same
# secret on the web server and supervised analysis worker; never prefix NEXT_PUBLIC_.
# OPENAI_MODEL=gpt-6.1-sol (configurable reasoning model; real account probe required)
# ROCKET_AI_DAILY_BUDGET_USD=2 (default app budget, USD per UTC day)
# Optional verified pricing for a model outside the built-in price catalog:
# ROCKET_AI_INPUT_USD_PER_MILLION=...
# ROCKET_AI_OUTPUT_USD_PER_MILLION=...
# Run npm run worker:analysis as a separate supervised service using the SAME
# PostgreSQL DATABASE_URL and encryption secret as the Vercel application.
# Optional protected scheduler endpoint /api/internal/ai-engine requires HTTPS:
# CRON_SECRET=<at least 32 random characters, managed only by the operator>
# It is not scheduled just by setting a secret; the app requires actual check-ins.
# On Vercel, ROCKET_QUEUE_ANALYSIS=1 enables the registered durable Queue consumer.
# Queue callbacks must genuinely check in before Start; no extra worker secret is used.
# Optional passkey migration on the canonical HTTPS dashboard. Link the owner's
# workspace from its original browser before requiring sign-in for all devices.
# ROCKET_ALLOW_LEGACY_CLAIM=1
# ROCKET_ACCOUNT_SIGNUP_ENABLED=1 (after private migration and release verification)
# ROCKET_ACCOUNTS_REQUIRED=1
# ROCKET_OWNER_USER_ID=<account reference displayed after passkey registration>
# Paid service setup. Test-mode Paystack credentials only.
# ROCKET_SUBSCRIPTIONS_REQUIRED=1 also requires permanent sign-in.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_WEBHOOK_SECRET=whsec_...
# ROCKET_PAYSTACK_PLANS=[{"id":"monthly","name":"Monthly","amount":19900,"code":"PLN_...","aiMonthlyBudgetUsd":2}]
# ROCKET_AI_PLATFORM_DAILY_BUDGET_USD=10
# Keep commercial Live disabled pending legal, operational and provider review.
# ROCKET_COMMERCIAL_LIVE_APPROVED=0
